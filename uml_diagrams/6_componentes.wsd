@startuml
package "Frontend (React)" {
  class AuthPage {
    +login()
    +register()
  }
  class Dashboard {
    +renderMetrics()
  }
  class Career {
    +buscarCarreira()
  }
  class AdminPanel {
    +login()
    +viewStats()
  }
}

package "Backend (FastAPI)" {
  class MainAPI {
    +GET /buscar
    +GET /carreira
    +POST /admin/login
    +GET /admin/stats
  }
  class JobScraper {
    +scrape_vagas_com_br()
    +scrape_linkedin()
    +scrape_infojobs()
    +scrape_remotive()
    +run_scrape(filtros)
  }
  class CareerAIAnalyzer {
    +analyze(cargo, filtros, vagas)
    +calculate_profile_match(profile, career)
    -_call_openai(prompt)
  }
  class CareerStore {
    +get_recent(cargo, filtros)
    +save(cargo, filtros, vagas, analysis)
  }
  class CourseCatalog {
    +get_or_fetch(cargo)
  }
}

AuthPage --> MainAPI : login/registro (Supabase Auth)
Dashboard --> MainAPI : fetch data
Career --> MainAPI : GET /carreira
AdminPanel --> MainAPI : admin/login + admin/stats

MainAPI --> JobScraper : uses
MainAPI --> CareerAIAnalyzer : uses
MainAPI --> CareerStore : cache + persistência
MainAPI --> CourseCatalog : cursos recomendados
CareerAIAnalyzer --> CourseCatalog : sugestões de curso
@enduml
