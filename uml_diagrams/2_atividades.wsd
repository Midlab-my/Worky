@startuml
start
:Usuário acessa o sistema;
if (Possui conta?) then (Não)
  :Realiza Cadastro;
else (Sim)
  :Faz Login;
endif
:Acessa Dashboard;
:Preenche Filtros (Cargo, Região, Modelo);
:Clica em Buscar;

fork
  :Backend: dispara scraping em paralelo\n(Vagas.com.br, LinkedIn, InfoJobs, Remotive);
  :Extrai dados brutos via httpx + BeautifulSoup;
fork again
  :Exibe Loading (Timeout seguro) no Front;
end fork

:Backend: Aplica Filtros Estritos (região/modelo/relevância);
if (Vaga atende aos filtros?) then (Sim)
  :Backend: Envia descrições para a OpenAI API;
  :IA extrai Hard/Soft Skills e insights de carreira;
else (Não)
  :Descartar Vaga;
endif

:Retorna Vagas Estruturadas;
:Frontend: Renderiza Gráficos e Cards;
stop
@enduml
