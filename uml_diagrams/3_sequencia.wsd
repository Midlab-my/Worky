@startuml
actor Usuário
participant "Frontend\n(React/Vite)" as Front
participant "Backend API\n(FastAPI)" as Back
participant "JobScraper\n(httpx + BeautifulSoup)" as Scraper

Usuário -> Front : Solicita busca de vagas (cargo, região, modelo)
Front -> Back : GET /buscar?filtros
Back -> Scraper : run_scrape(filtros)

par Coleta em paralelo
  Scraper -> Scraper : scrape_vagas_com_br()
else
  Scraper -> Scraper : scrape_linkedin()
else
  Scraper -> Scraper : scrape_infojobs()
else
  Scraper -> Scraper : scrape_remotive()
end

Scraper -> Back : Lista consolidada de vagas (JSON)
Back -> Front : Retorna vagas encontradas
Front -> Usuário : Exibe resultados da busca
@enduml
