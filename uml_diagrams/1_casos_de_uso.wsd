@startuml
left to right direction
skinparam packageStyle rectangle
actor "Usuário\n(Profissional)" as user

rectangle "Plataforma Worky" {
  usecase "Realizar Cadastro/Login" as UC1
  usecase "Configurar Perfil e Stack" as UC2
  usecase "Visualizar Dashboard" as UC3
  usecase "Buscar Vagas com Filtros" as UC4
  usecase "Visualizar Detalhes da Vaga" as UC5
  usecase "Visualizar Insights de Carreira (IA)" as UC6
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4
user --> UC5
user --> UC6

UC4 ..> UC5 : <<include>>
UC4 ..> UC6 : <<extend>>
@enduml
